# CogniPace settings (refreshed 29 Oct 2026). Every process.env.* the code reads is listed here.
# Local dev: copy to .env.local and fill in. Live site: Vercel > Project > Settings > Environment Variables
# (secrets: Production only). Placeholders only in this file - never put a real value here; it is committed to GitHub.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgres://user:pass@host/db
# Her link is https://<site>/?t=<STUDENT_TOKEN>. 40+ random characters; changing it signs her out everywhere.
STUDENT_TOKEN=change-me-long-random-string
# The guardian page password. Long and random, kept in Bitwarden. Changing it signs every guardian out.
GUARDIAN_PASSWORD=change-me
# Base32 secret for the guardian 2FA code (add the same secret to an authenticator app as a manual entry).
# Strongly recommended: with it, a stranger's failed tries can never keep the right person out (see docs/RUNBOOK.md).
GUARDIAN_TOTP_SECRET=

# --- The tutor model ---
# FALLBACK ONLY. curriculum/calendar.json "tutorModel" has dated entries (claude-fable-5-1 to 31 Oct 2026,
# claude-opus-5-5 from 1 Nov 2026 to 31 Dec 2027) and a dated entry OVERRIDES this value. Used only on a date no
# entry covers; if this is empty too, claude-sonnet-5-5. Real ids only: claude-opus-5-5, claude-sonnet-5-5,
# claude-fable-5-1, claude-haiku-5-5.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Optional (defaults in brackets) ---
STUDENT_NAME=Student
# The Anthropic console spend limit for THIS instance's key, shown on the guardian page (never enforced by the app). [200]
SPEND_LIMIT_USD=200
# FALLBACK ONLY: calendar.json "normalCapMinutes" (200) overrides it; vacations use their own capMinutes (420). [60]
DAILY_CAP_MINUTES=60
# Hard ceilings on tutor calls, enforced in the database - the safety net under the Anthropic console spend limit
# (Abid's, USD 60/month in Oct 2026). A vacation's callsCeiling in calendar.json (700) replaces the daily one. [300, 12]
MAX_TUTOR_CALLS_PER_DAY=300
MAX_TUTOR_CALLS_PER_MINUTE=12
# Correct answers in a row per skill to finish a practice set. [2]
PRACTICE_STREAK=2
# "1" = the daily typing warm-up is required before lessons; anything else = off. [off]
TYPING_GATE=
# Dhaka hours in which the plain GET /api/live may wake the database (for an uptime monitor). Nothing correct depends
# on it: push.ps1 uses /api/live?check=1, which always asks the database. "0:00-24:00" = always. [13:30-22:30]
WARM_WINDOW=13:30-22:30

# --- Set by Vercel itself (do not add) ---
# VERCEL_GIT_COMMIT_SHA - the commit a deployment was built from; /api/ping reports it and push.ps1 waits for it.
#   Needs "Automatically expose System Environment Variables" on (Project > Settings > Environment Variables; on by default).
# NODE_ENV - "production" on Vercel; makes the cookies Secure.
